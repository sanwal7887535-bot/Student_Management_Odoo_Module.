<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_student_low_attendance_alerts" model="ir.cron">
        <field name="name">Student Management: low attendance alerts</field>
        <field name="model_id" ref="model_student_student"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_low_attendance_alerts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_student_overdue_fee_reminders" model="ir.cron">
        <field name="name">Student Management: overdue fee reminders</field>
        <field name="model_id" ref="model_student_fee"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_overdue_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
