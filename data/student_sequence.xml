<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="seq_student_number" model="ir.sequence">
        <field name="name">Student ID</field>
        <field name="code">student.student</field>
        <field name="prefix">STU-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_student_course_code" model="ir.sequence">
        <field name="name">Course Code</field>
        <field name="code">student.course</field>
        <field name="prefix">CRS-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_student_teacher_number" model="ir.sequence">
        <field name="name">Teacher ID</field>
        <field name="code">student.teacher</field>
        <field name="prefix">TCH-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_student_attendance_session" model="ir.sequence">
        <field name="name">Attendance Session</field>
        <field name="code">student.attendance.session</field>
        <field name="prefix">ATT-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_student_fee" model="ir.sequence">
        <field name="name">Student Fee</field>
        <field name="code">student.fee</field>
        <field name="prefix">FEE-</field>
        <field name="padding">5</field>
    </record>
</odoo>
